# ---- Backend (copy to backend/.env locally; set as Render environment variables in production) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Comma-separated list of frontend origins allowed to call the API (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5500,https://your-app.vercel.app
RATE_LIMIT_DEFAULT=120/minute

# The service-role key and database password are NOT needed by this project. Do not add them.
# Frontend values (URL, anon key, API URL) go in frontend/js/config.js and are public by design.
